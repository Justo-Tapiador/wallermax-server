<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><?= (page.meta_title || page.title) ?> — wallermax</title>
<?jhs if (page.meta_description) { ?>
  <meta name="description" content="<?= page.meta_description ?>">
<?jhs } ?>
<?jhs if (page.og_image) { ?>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<?= page.meta_title || page.title ?>">
  <meta property="og:image" content="<?= page.og_image ?>">
<?jhs } ?>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <article class="tarjeta">
<?jhs if (!page.is_published) { ?>
      <p class="aviso aviso-info">Draft: only editors can see it; the public
         gets a 404 until it is published.<?jhs if (page.scheduled_for_h) { ?>
         It will be published automatically on <?= page.scheduled_for_h ?> (UTC).<?jhs } ?></p>
<?jhs } ?>
      <h1><?= page.title ?></h1>
<?jhs if (page.breadcrumbs && page.breadcrumbs.length) { ?>
      <p class="pagina-meta migas">
        <a href="/">Home</a><?jhs page.breadcrumbs.forEach(function (crumb) { ?> · <a href="/p/<?= crumb.slug ?>"><?= crumb.title ?></a><?jhs }); ?>
      </p>
<?jhs } ?>
      <p class="pagina-meta">
        /p/<?= page.slug ?> · updated <?= page.updated_at_h ?><?jhs if (page.author) { ?> · by <?= page.author ?><?jhs } ?>
<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
         · <a href="/admin/pages/<?= page.id ?>/edit">edit</a>
<?jhs } ?>
      </p>
      <div class="pagina-cuerpo">
<?jhs echo(raw(content)) ?>
      </div>
    </article>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
