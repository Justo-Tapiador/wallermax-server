<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><?= page.title ?> — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <article class="tarjeta">
<?jhs if (!page.is_published) { ?>
      <p class="aviso aviso-info">Borrador: solo lo ven los editores; el
         público recibe un 404 hasta que se publique.</p>
<?jhs } ?>
      <h1><?= page.title ?></h1>
      <p class="pagina-meta">
        /p/<?= page.slug ?> · actualizada <?= page.updated_at_h ?><?jhs if (page.author) { ?> · por <?= page.author ?><?jhs } ?>
<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
         · <a href="/admin/pages/<?= page.id ?>/edit">editar</a>
<?jhs } ?>
      </p>
      <div class="pagina-cuerpo">
<?jhs echo(raw(content)) ?>
      </div>
    </article>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
