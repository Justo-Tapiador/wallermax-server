<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Search — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="panel-barra">
      <h1>Search</h1>
      <a class="btn btn-fantasma" href="/p">All pages</a>
    </div>

    <section class="tarjeta">
      <form class="buscador" method="get" action="/search" role="search">
        <input type="search" name="q" value="<?= busqueda ?>" maxlength="200"
               placeholder="Words to search in title and content…" aria-label="Search the pages">
        <button class="btn btn-primario" type="submit">Search</button>
      </form>

<?jhs if (busqueda && resultados.length) { ?>
      <p class="ayuda"><?= total_resultados ?> result(s) for “<?= busqueda ?>”</p>
      <ul class="lista resultados">
<?jhs resultados.forEach(function (resultado) { ?>
        <li class="resultado">
          <div class="principal">
            <a href="/p/<?= resultado.slug ?>"><?= resultado.title ?></a>
            <p class="fragmento"><?jhs resultado.fragmento.forEach(function (segmento) { ?><?jhs if (segmento.hit) { ?><mark><?= segmento.texto ?></mark><?jhs } else { ?><?= segmento.texto ?><?jhs } ?><?jhs }); ?></p>
            <div class="secundario">/p/<?= resultado.slug ?> · updated <?= resultado.updated_at_h ?></div>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs include("partials/paginacion") ?>
<?jhs } else if (busqueda) { ?>
      <p class="vacio">No results for “<?= busqueda ?>”.
         Try other words or browse the full list.</p>
<?jhs } else { ?>
      <p class="vacio">Type what you are looking for and press “Search”.
         The index covers the title and the content of every
         published page.</p>
<?jhs } ?>
    </section>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
