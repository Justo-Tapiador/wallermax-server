<?jhs var titulo = menu.title + " (menus." + menu.name + ")"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Content / Menus / <?= menu.title ?></div>
    <div class="page-head">
      <div>
        <h1><?= menu.title ?> <span class="table-sub">(menus.<?= menu.name ?>)</span></h1>
        <p>Each item links a CMS page or a custom URL, with its label and position. Links to draft pages are skipped in the public navigation until they publish.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/menus">All menus</a>
        <a class="btn primary" href="/admin/menus/<?= menu.id ?>/items/new">&#43; Add item</a>
      </div>
    </div>

<?jhs if (query.ok == "creado") { ?>
    <p class="notice notice-ok">Menu created: add the first item below.</p>
<?jhs } ?>
<?jhs if (query.ok == "guardado") { ?>
    <p class="notice notice-ok">Title saved.</p>
<?jhs } ?>
<?jhs if (query.ok == "item-creado") { ?>
    <p class="notice notice-ok">Item added.</p>
<?jhs } ?>
<?jhs if (query.ok == "item-guardado") { ?>
    <p class="notice notice-ok">Item saved.</p>
<?jhs } ?>
<?jhs if (query.ok == "item-eliminado") { ?>
    <p class="notice notice-ok">Item deleted.</p>
<?jhs } ?>
<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

    <section class="card" aria-labelledby="elementos-titulo">
      <div class="card-head"><h2 id="elementos-titulo">Items (<?= items.length ?>)</h2></div>
<?jhs if (items && items.length) { ?>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Item</th><th>Position</th><th>Points to</th><th></th></tr>
          </thead>
          <tbody>
<?jhs items.forEach(function (elemento) { ?>
            <tr>
              <td><span class="table-title"><a href="<?= elemento.href ?>"><?= elemento.label ? elemento.label : (elemento.page ? elemento.page.title : "(no label)") ?></a></span></td>
              <td>#<?= elemento.position ?></td>
              <td>
<?jhs if (elemento.is_page) { ?>
                <span class="table-sub">page /p/<?= elemento.page.slug ?><?jhs if (!elemento.page.is_published) { ?> &middot; <span class="status draft">&#9679; draft</span> (hidden until published)<?jhs } ?></span>
<?jhs } else { ?>
                <span class="table-sub"><?= elemento.url ?></span>
<?jhs } ?>
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn" href="/admin/menus/<?= menu.id ?>/items/<?= elemento.id ?>/edit">Edit</a>
                  <form method="post" action="/admin/menus/<?= menu.id ?>/items/<?= elemento.id ?>/delete">
                    <button class="btn danger" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
<?jhs }); ?>
          </tbody>
        </table>
      </div>
<?jhs } else { ?>
      <div class="empty">
        <div class="empty-icon">&#9776;</div>
        <h2>No items</h2>
        <p>This menu has no items yet.</p>
      </div>
<?jhs } ?>
    </section>

    <section class="card" aria-labelledby="renombrar-titulo">
      <div class="card-head"><h2 id="renombrar-titulo">Rename (title only)</h2></div>
      <div class="card-body">
        <form method="post" action="/admin/menus/<?= menu.id ?>">
          <div class="field">
            <label for="titulo-menu">Title</label>
            <input class="input" id="titulo-menu" type="text" name="title" required maxlength="200"
                   value="<?= menu.title ?>">
            <small>The name <code><?= menu.name ?></code> is the key templates read and never changes: create another menu if you need another key.</small>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit">Save title</button>
          </div>
        </form>
      </div>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
