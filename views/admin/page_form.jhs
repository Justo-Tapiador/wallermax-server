<?jhs
  // The page editor (F12 shell). Field names are the server's
  // contract and never change — only the layout and language did.
  var titulo = form.is_new ? "New page" : "Edit page";
?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Pages<?jhs if (!form.is_new) { ?> / <?= form.title ?> / Edit<?jhs } ?></div>
    <div class="page-head">
      <div>
        <h1><?= titulo ?></h1>
        <p><?jhs if (form.is_new) { ?>A new page is saved as a draft: review it and publish when it is ready.<?jhs } else { ?>Every save lands a new revision in the history — append-only, reversible.<?jhs } ?></p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/pages">Back to list</a>
<?jhs if (!form.is_new) { ?>
        <a class="btn" href="/p/<?= form.slug ?>">View page</a>
        <a class="btn" href="/admin/pages/<?= form.id ?>/history">History</a>
<?jhs } ?>
      </div>
    </div>

<?jhs if (query.ok == "creada") { ?>
    <p class="notice notice-ok">Page created as a draft: review the content and check «Published» when it is ready.</p>
<?jhs } ?>
<?jhs if (query.ok == "guardada") { ?>
    <p class="notice notice-ok">Changes saved.</p>
<?jhs } ?>
<?jhs if (query.ok == "importada") { ?>
    <p class="notice notice-ok">Content imported as a draft: review it and publish whenever you want.</p>
<?jhs } ?>
<?jhs if (query.ok == "restored") { ?>
    <p class="notice notice-ok">Revision restored: the content is back, and the restoration itself is recorded as a new revision (reversible, like everything).</p>
<?jhs } ?>
<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

<?jhs if (preview_html) { ?>
    <section class="card" aria-labelledby="preview-titulo">
      <div class="card-head"><h2 id="preview-titulo">Preview</h2></div>
      <div class="card-body">
        <p class="table-sub">This is how the body renders with the chosen format. Nothing is saved yet: keep editing below and press «Save» when ready.</p>
        <div class="preview-body">
<?jhs echo(raw(preview_html)) ?>
        </div>
      </div>
    </section>
<?jhs } ?>

    <form method="post" action="<?= form.is_new ? "/admin/pages" : "/admin/pages/" + form.id ?>">
      <input type="hidden" name="page_id" value="<?= form.id == null ? "" : form.id ?>">
      <div class="form-layout">
        <div class="card editor-card">
          <input class="title-input" id="titulo" type="text" name="title" required
                 maxlength="200" value="<?= form.title ?>"
                 placeholder="Page title" aria-label="Page title">
          <div class="field">
            <label for="formato">Content format</label>
            <select class="select" id="formato" name="body_format">
              <option value="jhs"<?= form.body_format == "markdown" ? "" : " selected" ?>>.jhs template — HTML with &lt;?= ?&gt; tags</option>
              <option value="markdown"<?= form.body_format == "markdown" ? " selected" : "" ?>>Markdown — plain text</option>
            </select>
            <small>Markdown is the safe writing mode: rendered on the server, raw HTML is discarded. The .jhs template is the powerful mode (tags, globals, include) for editors.</small>
          </div>
          <div class="field">
            <label for="contenido">Content — <?= form.body_format == "markdown" ? "Markdown" : ".jhs template" ?></label>
            <textarea class="body-editor" id="contenido" name="content" spellcheck="false"
                      placeholder="<?= form.body_format == "markdown" ? "# Heading&#10;&#10;Paragraph with **bold** and [a link](https://example.com)&#8230;" : "&lt;h2&gt;Hello&lt;/h2&gt;&#10;&lt;p&gt;HTML with &lt;?= user ?&gt; globals available&hellip;&lt;/p&gt;" ?>"><?= form.content ?></textarea>
<?jhs if (form.body_format == "markdown") { ?>
            <small>Headings #, lists, quotes, code blocks, tables and links. Images go as <code>![alt text](/media/&hellip;)</code>: upload the file to the <a href="/admin/media">media library</a> and copy the ready snippet from its detail page. Raw HTML is discarded and links to strange schemes (javascript:, data:) are degraded: a page can never become a script carrier. Press «Preview» below to see the exact render before saving.</small>
<?jhs } else { ?>
            <small>HTML with <code>&lt;?= expression ?&gt;</code> and <code>&lt;?jhs code ?&gt;</code> tags (the same engine the views use). The globals <code>user</code>, <code>path</code>, <code>query</code> and <code>pages</code> are available, plus <code>&lt;?jhs include("partials/header") ?&gt;</code> to reuse the site chrome. Auto-escaping is on: use <code>raw()</code> only for trusted HTML.</small>
<?jhs } ?>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit"><?= form.is_new ? "Create page" : "Save changes" ?></button>
            <button class="btn" type="submit" formaction="/admin/pages/preview"
                    formmethod="post">Preview</button>
          </div>
        </div>

        <aside class="card sidebar-card">
          <div class="field">
            <label for="slug">Slug (the public URL is /p/slug)</label>
            <input class="input" id="slug" type="text" name="slug" required maxlength="64"
                   value="<?= form.slug ?>">
            <small>Lowercase, digits and hyphens: <code>about-us</code>. Changing it moves the page's public URL.</small>
          </div>
          <div class="field">
            <label for="padre">Parent page</label>
            <select class="select" id="padre" name="parent_id">
              <option value=""<?= form.parent_id == null ? " selected" : "" ?>>&mdash; Top level &mdash;</option>
<?jhs form.parents.forEach(function (opcion) { ?>
              <option value="<?= opcion.id ?>"<?= form.parent_id == opcion.id ? " selected" : "" ?>><?= opcion.label ?></option>
<?jhs }); ?>
            </select>
            <small>The hierarchy feeds menus, breadcrumbs and subpage listings. A page can never hang from its own branch.</small>
          </div>
          <div class="field">
            <label for="posicion">Position (order among siblings)</label>
            <input class="input" id="posicion" type="number" name="position" min="0" max="99999"
                   value="<?= form.position ?>">
            <small>Lower number = first. Ties break by creation order.</small>
          </div>
          <div class="divider"></div>
          <label class="check">
            <input id="publicada" type="checkbox" name="is_published" value="on"<?= form.is_published ? " checked" : "" ?>>
            <span>Published (visible on /p and the public listing)</span>
          </label>
          <div class="field">
            <label for="programada">Schedule publication (UTC)</label>
            <input class="input" id="programada" type="datetime-local" name="publish_at" value="<?= form.publish_at ?>">
            <small>Draft + future date: the page publishes itself when the moment arrives — no cron, no restarts; visibility is decided on every read. Interpreted as UTC (the server's clock). A past date is dropped on save, and a page checked as «Published» ignores this field.</small>
          </div>
          <div class="field">
            <label for="nota">Revision note (optional)</label>
            <input class="input" id="nota" type="text" name="revision_note" maxlength="200"
                   placeholder="What you changed — kept with the history"
                   value="<?= form.revision_note ?>">
            <small>Every save — create, edit, restore — records a content revision; this note rides along in the <a href="<?= form.is_new ? "/admin/pages" : "/admin/pages/" + form.id + "/history" ?>">history</a>.</small>
          </div>
          <div class="divider"></div>
          <div class="field">
            <label for="meta-titulo">SEO title</label>
            <input class="input" id="meta-titulo" type="text" name="meta_title" maxlength="200"
                   value="<?= form.meta_title ?>">
            <small>Empty = use the page title. Search engines show ~60 characters.</small>
          </div>
          <div class="field">
            <label for="meta-descripcion">Meta description</label>
            <input class="input" id="meta-descripcion" type="text" name="meta_description" maxlength="500"
                   value="<?= form.meta_description ?>">
            <small>Empty = no tag. Search engines show ~160 characters.</small>
          </div>
          <div class="field">
            <label for="og-imagen">Social image (og:image)</label>
            <input class="input" id="og-imagen" type="text" name="og_image" maxlength="500"
                   placeholder="/assets/og-home.png" value="<?= form.og_image ?>">
            <small>A site path (<code>/assets/&hellip;</code>) or an absolute URL.</small>
          </div>
        </aside>
      </div>
    </form>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
