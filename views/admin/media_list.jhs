<?jhs var titulo = "Media library"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Content / Media</div>
    <div class="page-head">
      <div>
        <h1>Media library</h1>
        <p>Manage images, thumbnails and brand assets.</p>
      </div>
    </div>

<?jhs if (query.ok == "eliminado") { ?>
    <p class="notice notice-ok">File deleted. Remember: pages still linking to it will show a gap — their <code>&lt;img&gt;</code> pointed at that URL.</p>
<?jhs } ?>
<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

    <section class="card" aria-labelledby="subida-titulo">
      <div class="card-head"><h2 id="subida-titulo">Upload an image</h2></div>
      <div class="card-body">
        <form method="post" action="/admin/media" enctype="multipart/form-data">
          <div class="form-layout">
            <div class="field">
              <label for="archivo">File (PNG, JPEG, GIF or WebP)</label>
              <input class="input" id="archivo" type="file" name="file" required
                     accept="image/png,image/jpeg,image/gif,image/webp">
              <small>The server checks the real byte signature and decodes the image before storing it: a renamed or corrupt file never passes. The size cap is <code>[cms] media_max_bytes</code>.</small>
            </div>
            <div class="field">
              <label for="alt">Alt text (optional, editable later)</label>
              <input class="input" id="alt" type="text" name="alt" maxlength="500" value="<?= alt_text ?>"
                     placeholder="Company logo on a white background">
              <small>Describe the image for screen readers and search engines; the detail page hands it back ready to paste into Markdown.</small>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit">Upload</button>
          </div>
        </form>
      </div>
    </section>

    <section class="card" aria-labelledby="medios-titulo">
      <div class="card-head"><h2 id="medios-titulo">Files</h2></div>
<?jhs if (media_items && media_items.length) { ?>
      <div class="media-grid">
<?jhs media_items.forEach(function (medio) { ?>
        <div class="media-item">
          <a href="/admin/media/<?= medio.id ?>" class="media-thumb" aria-label="<?= medio.original_name ?>">
            <img src="<?= medio.thumb_url ?>" alt="<?= medio.alt_text ?>" loading="lazy">
          </a>
          <div class="media-info">
            <strong><a href="/admin/media/<?= medio.id ?>"><?= medio.original_name ?></a></strong>
            <span><?= medio.width ?> &times; <?= medio.height ?> &middot; <?= medio.size_h ?></span>
            <span class="media-alt"><?= medio.alt_text ?></span>
          </div>
        </div>
<?jhs }); ?>
      </div>
<?jhs include("partials/admin/pagination") ?>
<?jhs } else { ?>
      <div class="empty">
        <div class="empty-icon">&#9639;</div>
        <h2>The library is empty</h2>
        <p>Upload the first image with the form above.</p>
      </div>
<?jhs } ?>
      <div class="card-body">
        <p class="table-sub">The grid shows the newest page of the library (<?= paginacion ? paginacion.total_items : 0 ?> files in total, 24 per page). Every upload gets a final, immutable URL (<code>/media/&lt;id&gt;/&lt;name&gt;</code>): the detail page carries the ready-to-copy snippets.</p>
      </div>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
