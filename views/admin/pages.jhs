<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Páginas — CMS wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="panel-barra">
      <h1>Páginas</h1>
      <a class="btn btn-fantasma" href="/admin">Panel</a>
      <a class="btn btn-fantasma" href="/admin/pages/import">Importar</a>
      <a class="btn btn-fantasma" href="/admin/media">Medios</a>
      <a class="btn btn-primario" href="/admin/pages/new">Nueva página</a>
    </div>

<?jhs if (query.ok == "eliminada") { ?>
    <p class="aviso aviso-ok">Página eliminada.</p>
<?jhs } ?>

    <section class="tarjeta">
      <form class="buscador" method="get" action="/admin/pages" role="search">
        <input type="search" name="q" value="<?= filtro ?>" maxlength="200"
               placeholder="Filtrar páginas por palabras (título y cuerpo)…"
               aria-label="Filtrar páginas">
        <button class="btn btn-fantasma" type="submit">Filtrar</button>
<?jhs if (filtro) { ?>
        <a class="btn btn-fantasma" href="/admin/pages">Quitar el filtro</a>
<?jhs } ?>
      </form>
    </section>

<?jhs if (filtro && admin_resultados) { ?>
    <section class="tarjeta">
<?jhs if (admin_resultados.length) { ?>
      <p class="ayuda"><?= admin_resultados.length ?> resultado(s) — el filtro busca en el
         título y en el cuerpo tal como está guardado (borradores incluidos: sirve para
         localizar referencias, como una URL de la biblioteca de medios).</p>
      <ul class="lista resultados">
<?jhs admin_resultados.forEach(function (pagina) { ?>
        <li class="resultado">
          <div class="principal">
            <a href="/p/<?= pagina.slug ?>"><?= pagina.title ?></a>
            <p class="fragmento"><?jhs pagina.fragmento.forEach(function (segmento) { ?><?jhs if (segmento.hit) { ?><mark><?= segmento.texto ?></mark><?jhs } else { ?><?= segmento.texto ?><?jhs } ?><?jhs }); ?></p>
            <div class="secundario">/p/<?= pagina.slug ?> · actualizada <?= pagina.updated_at_h ?></div>
          </div>
<?jhs if (pagina.estado == "publicada") { ?>
          <span class="publicado">publicada</span>
<?jhs } else if (pagina.estado == "programada") { ?>
          <span class="borrador">programada<?= pagina.publish_at_h ? " · " + pagina.publish_at_h : "" ?></span>
<?jhs } else { ?>
          <span class="borrador">borrador</span>
<?jhs } ?>
          <div class="acciones">
            <a class="btn btn-fantasma" href="/admin/pages/<?= pagina.id ?>/edit">Editar</a>
            <a class="btn btn-fantasma" href="/admin/pages/<?= pagina.id ?>/history">Historial</a>
            <form method="post" action="/admin/pages/<?= pagina.id ?>/delete">
              <button class="btn btn-peligro" type="submit">Borrar</button>
            </form>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs } else { ?>
      <p class="vacio">Ninguna página (ni borrador) coincide con «<?= filtro ?>».</p>
<?jhs } ?>
    </section>
<?jhs } else { ?>
    <section class="tarjeta">
<?jhs if (admin_pages && admin_pages.length) { ?>
      <ul class="lista">
<?jhs admin_pages.forEach(function (pagina) { ?>
        <li>
          <div class="principal" style="padding-left:<?= pagina.depth * 1.25 ?>rem">
            <a href="/p/<?= pagina.slug ?>"><?= pagina.title ?></a>
            <div class="secundario">/p/<?= pagina.slug ?> · actualizada <?= pagina.updated_at_h ?></div>
          </div>
<?jhs if (pagina.estado == "publicada") { ?>
          <span class="publicado">publicada</span>
<?jhs } else if (pagina.estado == "programada") { ?>
          <span class="borrador">programada<?= pagina.publish_at_h ? " · " + pagina.publish_at_h : "" ?></span>
<?jhs } else { ?>
          <span class="borrador">borrador</span>
<?jhs } ?>
          <div class="acciones">
            <a class="btn btn-fantasma" href="/admin/pages/<?= pagina.id ?>/edit">Editar</a>
            <a class="btn btn-fantasma" href="/admin/pages/<?= pagina.id ?>/history">Historial</a>
            <form method="post" action="/admin/pages/<?= pagina.id ?>/delete">
              <button class="btn btn-peligro" type="submit">Borrar</button>
            </form>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs } else { ?>
      <p class="vacio">No hay páginas todavía: crea la primera o importa un
         archivo de <code>public/</code>.</p>
<?jhs } ?>
      <p class="ayuda">El listado muestra la jerarquía completa: las hijas van indentadas
         bajo su padre y el orden entre hermanas lo marca su «posición».</p>
    </section>
<?jhs } ?>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
