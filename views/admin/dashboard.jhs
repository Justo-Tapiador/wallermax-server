<?jhs var titulo = "Dashboard"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Overview / Dashboard</div>
    <div class="page-head">
      <div>
        <h1>Dashboard</h1>
        <p>Manage your corporate website and content.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/">View site</a>
        <a class="btn primary" href="/admin/pages/new">&#43; New page</a>
      </div>
    </div>

    <div class="grid stats">
      <div class="card stat">
        <div class="stat-label">Total pages</div>
        <div class="stat-value"><?= stats.pages ?></div>
        <div class="stat-meta">in the tree</div>
      </div>
      <div class="card stat">
        <div class="stat-label">Published</div>
        <div class="stat-value"><?= stats.published ?></div>
        <div class="stat-meta">publicly visible</div>
      </div>
      <div class="card stat">
        <div class="stat-label">Drafts</div>
        <div class="stat-value"><?= stats.drafts ?></div>
        <div class="stat-meta">not yet public</div>
      </div>
      <div class="card stat">
        <div class="stat-label">Scheduled</div>
        <div class="stat-value"><?= stats.scheduled ?></div>
        <div class="stat-meta">will publish themselves</div>
      </div>
      <div class="card stat">
        <div class="stat-label">Media files</div>
        <div class="stat-value"><?= stats.media ?></div>
        <div class="stat-meta">in the library</div>
      </div>
      <div class="card stat">
        <div class="stat-label">Menus</div>
        <div class="stat-value"><?= stats.menus ?></div>
        <div class="stat-meta">navigation sets</div>
      </div>
<?jhs if (user && user.role == "admin") { ?>
      <div class="card stat">
        <div class="stat-label">Users</div>
        <div class="stat-value"><?= stats.users ?></div>
        <div class="stat-meta">editor accounts</div>
      </div>
<?jhs } ?>
    </div>

    <div class="grid two-col">
      <section class="card">
        <div class="card-head">
          <h2>Recent activity</h2>
          <a class="btn" href="/admin/pages">Pages</a>
        </div>
        <div class="card-body">
<?jhs if (actividad && actividad.length) { ?>
<?jhs actividad.forEach(function (cambio) { ?>
          <div class="activity">
            <span class="dot"></span>
            <div>
              <strong><?= cambio.editor ? cambio.editor : "Unknown editor" ?></strong>
              <p>Saved
                 <a href="/admin/pages/<?= cambio.page_id ?>/history">«<?= cambio.title ?>»</a><?jhs if (cambio.note) { ?> — <?= cambio.note ?><?jhs } ?></p>
            </div>
            <span class="time"><?= cambio.created_at_h ?></span>
          </div>
<?jhs }); ?>
<?jhs } else { ?>
          <div class="empty">
            <div class="empty-icon">&#9670;</div>
            <h2>No revisions yet</h2>
            <p>Every save — create, edit, restore — lands here.</p>
          </div>
<?jhs } ?>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Needs attention</h2>
        </div>
        <div class="card-body">
<?jhs if (programadas && programadas.length) { ?>
<?jhs programadas.forEach(function (pagina) { ?>
          <div class="activity">
            <span class="dot"></span>
            <div>
              <strong>Scheduled</strong>
              <p><a href="/admin/pages/<?= pagina.id ?>/edit"><?= pagina.title ?></a>
                 goes live <?= pagina.publish_at_h ?></p>
            </div>
          </div>
<?jhs }); ?>
<?jhs } ?>
<?jhs if (stats.drafts > 0) { ?>
          <div class="activity">
            <span class="dot"></span>
            <div>
              <strong><?= stats.drafts ?> draft<?= stats.drafts == 1 ? "" : "s" ?></strong>
              <p><a href="/admin/pages">Not public yet</a> — publish when ready.</p>
            </div>
          </div>
<?jhs } ?>
<?jhs if (!(programadas && programadas.length) && stats.drafts == 0) { ?>
          <div class="empty">
            <div class="empty-icon">&#10003;</div>
            <h2>Nothing pending</h2>
            <p>No scheduled pages, no drafts waiting.</p>
          </div>
<?jhs } ?>
        </div>
      </section>
    </div>

    <section class="card" aria-labelledby="alcance-titulo">
      <div class="card-head"><h2 id="alcance-titulo">What this panel manages</h2></div>
      <div class="card-body">
        <p><strong>Content and accounts, nothing else.</strong> The server's own
        configuration (ports, TLS, secrets, middleware) lives in
        <code>wallermax.toml</code>, reachable only with local access to the
        repository — the deliberate split between the CMS administrator and
        whoever operates the server.</p>
      </div>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
