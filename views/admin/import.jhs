<?jhs var titulo = "Import from public/"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Pages / Import</div>
    <div class="page-head">
      <div>
        <h1>Import from public/</h1>
        <p>Copy a file from the static tree into a new editable draft.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/pages">Back to list</a>
      </div>
    </div>

<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

    <section class="card">
      <div class="card-body">
        <p>Pick a file from the static tree to copy its content into a new <strong>draft</strong>. Importing <em>reads</em> from <code>public/</code> but never writes there: from here on the page lives in SQLite and is edited from the panel.</p>
      </div>
<?jhs if (files && files.length) { ?>
      <form method="post" action="/admin/pages/import">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>File</th><th>Size</th><th>Kind</th><th></th></tr>
            </thead>
            <tbody>
<?jhs files.forEach(function (archivo) { ?>
<?jhs var id_archivo = "archivo-" + archivo.path.replace(/[^a-zA-Z0-9-]/g, "-"); ?>
              <tr>
                <td><span class="table-title"><code><?= archivo.path ?></code></span></td>
                <td><?= Math.round(archivo.bytes / 1024) ?> KB</td>
                <td><span class="table-sub"><?= archivo.kind == "jhs" ? ".jhs template (keeps rendering)" : "static HTML" ?></span></td>
                <td>
                  <label class="check">
                    <input type="radio" id="<?= id_archivo ?>" name="file" value="<?= archivo.path ?>" required>
                    <span>Pick</span>
                  </label>
                </td>
              </tr>
<?jhs }); ?>
            </tbody>
          </table>
        </div>
        <div class="card-body">
          <button class="btn primary" type="submit">Import as draft</button>
        </div>
      </form>
<?jhs } else { ?>
      <div class="empty">
        <div class="empty-icon">&#8611;</div>
        <h2>Nothing to import</h2>
        <p>No importable <code>.html</code> or <code>.jhs</code> files in <code>public/</code> (up to 200 are listed, 600 KB or smaller, three levels deep).</p>
      </div>
<?jhs } ?>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
