<?jhs var titulo = item.original_name + " — media"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Content / Media / <?= item.original_name ?></div>
    <div class="page-head">
      <div>
        <h1><?= item.original_name ?></h1>
        <p><?= item.mime_type ?> &middot; <?= item.size_h ?> &middot; <?= item.width ?> &times; <?= item.height ?> pixels &middot; uploaded <?= item.created_at_h ?></p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/media">Library</a>
      </div>
    </div>

<?jhs if (query.ok == "alt") { ?>
    <p class="notice notice-ok">Alt text updated (the snippets below already use it).</p>
<?jhs } ?>
<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

    <section class="card" aria-labelledby="imagen-titulo">
      <div class="card-head"><h2 id="imagen-titulo">The image</h2></div>
      <div class="card-body">
        <img class="detalle-imagen" src="<?= item.url ?>" alt="<?= item.alt_text ?>"
             width="<?= item.width ?>" height="<?= item.height ?>">
        <dl class="detalle">
          <dt>Final URL</dt><dd><code><?= item.url ?></code></dd>
          <dt>Stored name</dt><dd><code><?= item.stored_name ?></code> (server-generated: flat, unique, nothing of yours in the path)</dd>
        </dl>
      </div>
    </section>

    <section class="card" aria-labelledby="pegar-titulo">
      <div class="card-head"><h2 id="pegar-titulo">Ready to paste</h2></div>
      <div class="card-body">
        <p class="table-sub">In a Markdown page the snippet already carries the alt text. In a <code>.jhs</code> template paste the HTML as is.</p>
        <div class="field">
          <label for="snippet-markdown">Markdown</label>
          <textarea class="textarea" id="snippet-markdown" readonly rows="2" spellcheck="false"><?= markdown_snippet ?></textarea>
        </div>
        <div class="field">
          <label for="snippet-html">HTML</label>
          <textarea class="textarea" id="snippet-html" readonly rows="2" spellcheck="false"><?= html_snippet ?></textarea>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="alt-titulo">
      <div class="card-head"><h2 id="alt-titulo">Alt text</h2></div>
      <div class="card-body">
        <form method="post" action="/admin/media/<?= item.id ?>/alt">
          <div class="field">
            <label for="alt">Image description</label>
            <input class="input" id="alt" type="text" name="alt" maxlength="500" value="<?= item.alt_text ?>"
                   placeholder="Company logo on a white background">
            <small>Screen readers and search engines read it; it also feeds the snippets above.</small>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit">Save text</button>
          </div>
        </form>
      </div>
    </section>

    <section class="card" aria-labelledby="borrar-titulo">
      <div class="card-head"><h2 id="borrar-titulo">Delete</h2></div>
      <div class="card-body">
        <form method="post" action="/admin/media/<?= item.id ?>/delete">
          <button class="btn danger" type="submit">Delete this file</button>
          <p class="table-sub">Deletes the file and its row; the public URL will answer 404. Pages still linking to it will show a gap — review them first.</p>
        </form>
      </div>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
