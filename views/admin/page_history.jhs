<?jhs var titulo = "History — " + page.title; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Pages / <?= page.title ?> / History</div>
    <div class="page-head">
      <div>
        <h1>History of «<?= page.title ?>»</h1>
        <p>Every save — create, edit or restore — leaves a revision with the content as saved, newest first. Restoring is append-only: the history never loses anything.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/pages">Back to list</a>
        <a class="btn primary" href="/admin/pages/<?= page.id ?>/edit">Edit the page</a>
      </div>
    </div>

    <section class="card">
<?jhs if (revisiones && revisiones.length) { ?>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Revision</th><th>Saved</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
<?jhs revisiones.forEach(function (revision) { ?>
            <tr>
              <td>
                <span class="table-title"><a href="/admin/pages/<?= page.id ?>/history/<?= revision.revision ?>">Revision <?= revision.revision ?><?= revision.is_current ? " — current" : "" ?></a></span>
<?jhs if (revision.note) { ?>
                <p class="resultado-fragmento"><?= revision.note ?></p>
<?jhs } ?>
                <span class="table-sub">/p/<?= revision.slug ?></span>
              </td>
              <td>
                <?= revision.created_at_h ?>
<?jhs if (revision.edited_by_name) { ?>
                <span class="table-sub">by <?= revision.edited_by_name ?></span>
<?jhs } ?>
              </td>
<?jhs if (revision.estado == "published") { ?>
              <td><span class="status published">&#9679; Published</span></td>
<?jhs } else if (revision.estado == "scheduled") { ?>
              <td><span class="status scheduled">&#9679; Scheduled<?= revision.publish_at_h ? " · " + revision.publish_at_h : "" ?></span></td>
<?jhs } else { ?>
              <td><span class="status draft">&#9679; Draft</span></td>
<?jhs } ?>
              <td>
                <div class="row-actions">
                  <a class="btn" href="/admin/pages/<?= page.id ?>/history/<?= revision.revision ?>">View</a>
                </div>
              </td>
            </tr>
<?jhs }); ?>
          </tbody>
        </table>
      </div>
      <div class="card-body">
        <p class="table-sub">How many are kept is server configuration (<code>[cms] max_revisions</code>): the oldest snapshots are pruned inside the same write.</p>
      </div>
<?jhs } else { ?>
      <div class="empty">
        <div class="empty-icon">&#8635;</div>
        <h2>No revisions</h2>
        <p>This page has no saved revisions yet.</p>
      </div>
<?jhs } ?>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
