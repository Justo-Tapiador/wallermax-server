<?jhs var titulo = form.is_new ? "New account" : "Edit account"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Team / Users<?jhs if (!form.is_new) { ?> / <?= form.username ?><?jhs } ?></div>
    <div class="page-head">
      <div>
        <h1><?= titulo ?></h1>
        <p>Accounts, roles and password resets — administrators only.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/users">Back to list</a>
      </div>
    </div>

<?jhs if (form_error) { ?>
    <p class="notice notice-error"><?= form_error ?></p>
<?jhs } ?>

    <form method="post" action="<?= form.is_new ? "/admin/users" : "/admin/users/" + form.id ?>">
      <div class="form-layout">
        <div class="card editor-card">
<?jhs if (form.is_new) { ?>
          <div class="field">
            <label for="usuario">Username</label>
            <input class="input" id="usuario" type="text" name="username" required
                   minlength="3" maxlength="32" autocomplete="off">
            <small>3-32 characters: letters, digits, hyphen and underscore.</small>
          </div>
          <div class="field">
            <label for="clave">Initial password</label>
            <input class="input" id="clave" type="password" name="password" required
                   minlength="8" autocomplete="new-password">
            <small>At least 8 characters. The person can change it later from their profile.</small>
          </div>
<?jhs } else { ?>
          <div class="field">
            <label>Username</label>
            <input class="input" type="text" value="<?= form.username ?>" disabled>
            <small>The username never changes.</small>
          </div>
          <div class="field">
            <label for="clave">New password (optional)</label>
            <input class="input" id="clave" type="password" name="password"
                   minlength="8" autocomplete="new-password">
            <small>Leave empty to keep the current one.</small>
          </div>
<?jhs } ?>
          <div class="field">
            <label for="rol">Role</label>
            <select class="select" id="rol" name="role">
              <option value="user"<?= form.role == "user" ? " selected" : "" ?>>User — pages are read-only</option>
              <option value="editor"<?= form.role == "editor" ? " selected" : "" ?>>Editor — manages content</option>
              <option value="admin"<?= form.role == "admin" ? " selected" : "" ?>>Administrator — content and accounts</option>
            </select>
            <small>The role travels inside the signed token: the next time the person signs in they will see their new scope.</small>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit"><?= form.is_new ? "Create account" : "Save changes" ?></button>
          </div>
        </div>
        <aside class="card sidebar-card">
          <div class="field">
            <label>What each role can do</label>
            <small>
              <strong>User</strong> — reads published pages, nothing in the panel.<br>
              <strong>Editor</strong> — everything in this panel except accounts: pages, media, menus, history.<br>
              <strong>Administrator</strong> — all of the above plus the Users section and account management.
            </small>
          </div>
        </aside>
      </div>
    </form>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
