<?jhs var titulo = "Users"; ?>
<?jhs include("partials/admin/head") ?>
<?jhs include("partials/admin/sidebar") ?>
<main class="main">
<?jhs include("partials/admin/topbar") ?>
  <section class="page">
    <div class="breadcrumbs">Team / Users</div>
    <div class="page-head">
      <div>
        <h1>Users</h1>
        <p>Manage access to the CMS and editorial workflows.</p>
      </div>
      <div class="actions">
        <a class="btn primary" href="/admin/users/new">&#43; New account</a>
      </div>
    </div>

<?jhs if (query.ok == "created") { ?>
    <p class="notice notice-ok">Account created.</p>
<?jhs } ?>
<?jhs if (query.ok == "saved") { ?>
    <p class="notice notice-ok">Changes saved.</p>
<?jhs } ?>
<?jhs if (query.ok == "deleted") { ?>
    <p class="notice notice-ok">Account deleted (its refresh tokens are revoked; access tokens expire on their own within the hour).</p>
<?jhs } ?>
<?jhs if (query.error == "propia") { ?>
    <p class="notice notice-error">You cannot delete your own account: use another administrator account.</p>
<?jhs } ?>
<?jhs if (query.error == "ultimo-admin") { ?>
    <p class="notice notice-error">This is the last administrator account and cannot be deleted.</p>
<?jhs } ?>
<?jhs if (query.error == "solo-tenant-admin") { ?>
    <p class="notice notice-error">This account is the last administrator of the <?= query.tenant ?> organization — grant another administrator there (or remove the membership) before deleting it.</p>
<?jhs } ?>

    <section class="card">
<?jhs if (admin_users && admin_users.length) { ?>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>User</th><th>Role</th><th>Last active</th><th></th></tr>
          </thead>
          <tbody>
<?jhs admin_users.forEach(function (cuenta) { ?>
            <tr>
              <td>
                <span class="table-title"><?= cuenta.username ?><?jhs if (user && cuenta.id == user.id) { ?> <span class="table-sub">(you)</span><?jhs } ?></span>
                <span class="table-sub">joined <?= cuenta.created_at_h ?></span>
              </td>
              <td><span class="status published"><?= cuenta.role ?></span></td>
              <td><?jhs if (cuenta.last_login_at_h) { ?><?= cuenta.last_login_at_h ?><?jhs } else { ?>&mdash;<?jhs } ?></td>
              <td>
                <div class="row-actions">
                  <a class="btn" href="/admin/users/<?= cuenta.id ?>/edit">Edit</a>
<?jhs if (!(user && cuenta.id == user.id)) { ?>
                  <form method="post" action="/admin/users/<?= cuenta.id ?>/delete">
                    <button class="btn danger" type="submit">Delete</button>
                  </form>
<?jhs } ?>
                </div>
              </td>
            </tr>
<?jhs }); ?>
          </tbody>
        </table>
      </div>
<?jhs } else { ?>
      <div class="empty">
        <div class="empty-icon">&#9678;</div>
        <h2>No accounts</h2>
        <p>Odd — you are signed in yourself.</p>
      </div>
<?jhs } ?>
    </section>
  </section>
</main>
<?jhs include("partials/admin/foot") ?>
