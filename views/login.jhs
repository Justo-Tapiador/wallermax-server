<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><?= user ? "Your session" : "Sign in" ?> — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
<?jhs
  var destino = query.redirect || "/profile";
  var loginErrors = {
    invalid: "Wrong username or password.",
    post_register: "The account was created, but sign-in failed: try signing in again."
  };
  var loginError = query.login_error
    ? (loginErrors[query.login_error] || "Sign-in failed.")
    : null;
?>
<?jhs if (user) { ?>
    <section class="tarjeta tarjeta-angosta">
      <h1>You are already signed in</h1>
      <p>Active session as <strong><?= user.username ?></strong>
         (<?= user.role ?>).</p>
      <p><a class="btn btn-primario" href="/profile">Go to your profile</a></p>
      <form method="post" action="/api/auth/logout">
        <input type="hidden" name="redirect" value="/">
        <button class="btn btn-fantasma" type="submit">Sign out</button>
      </form>
    </section>
<?jhs } else { ?>
    <section class="tarjeta tarjeta-angosta">
      <h1>Sign in</h1>
<?jhs if (loginError) { ?>
      <p class="aviso aviso-error"><?= loginError ?></p>
<?jhs } ?>
      <p>The server will leave an <code>HttpOnly</code> session cookie in
         your browser and the pages will personalize themselves.</p>
      <form method="post" action="/api/auth/login">
        <input type="hidden" name="redirect" value="<?= destino ?>">
        <div class="campo">
          <label for="usuario">Username</label>
          <input id="usuario" type="text" name="username" required
                 minlength="3" maxlength="32" autocomplete="username">
        </div>
        <div class="campo">
          <label for="clave">Password</label>
          <input id="clave" type="password" name="password" required
                 autocomplete="current-password">
        </div>
        <button class="btn btn-primario" type="submit">Sign in</button>
      </form>
      <p>No account yet? <a href="/register">Register</a>.</p>
    </section>
<?jhs } ?>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
