<?jhs
  // Index of published pages (F10): `/p` is now a real route that
  // serves one window of the listing (`paginas`) plus the
  // `paginacion`. The fallback to the `pages` global covers a disabled
  // CMS (the auto-router serves this view again with only the global).
  var lista = (typeof paginas !== "undefined" && paginas) ? paginas : (pages || []);
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pages — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="panel-barra">
      <h1>Pages</h1>
<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
      <a class="btn btn-fantasma" href="/admin/pages">Manage in the CMS</a>
<?jhs } ?>
    </div>

    <section class="tarjeta">
<?jhs if (lista && lista.length) { ?>
      <ul class="lista">
<?jhs lista.forEach(function (page) { ?>
        <li>
          <div class="principal">
            <a href="/p/<?= page.slug ?>"><?= page.title ?></a>
            <div class="secundario">/p/<?= page.slug ?> · updated <?= page.updated_at_h ?></div>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs include("partials/paginacion") ?>
<?jhs } else { ?>
      <p class="vacio">No published pages yet. Editors can
         <a href="/admin/pages/new">create the first one</a>.</p>
<?jhs } ?>
    </section>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
