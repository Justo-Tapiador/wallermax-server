<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Páginas — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="panel-barra">
      <h1>Páginas</h1>
<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
      <a class="btn btn-fantasma" href="/admin/pages">Gestionar en el CMS</a>
<?jhs } ?>
    </div>

    <section class="tarjeta">
<?jhs if (pages && pages.length) { ?>
      <ul class="lista">
<?jhs pages.forEach(function (pagina) { ?>
        <li>
          <div class="principal">
            <a href="/p/<?= pagina.slug ?>"><?= pagina.title ?></a>
            <div class="secundario">/p/<?= pagina.slug ?> · actualizada <?= pagina.updated_at_h ?></div>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs } else { ?>
      <p class="vacio">Todavía no hay páginas publicadas.
         Los editores pueden <a href="/admin/pages/new">crear la primera</a>.</p>
<?jhs } ?>
    </section>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
