<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inicio — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="hero">
      <h1>Un sitio que administra su contenido a sí mismo</h1>
      <p>Estás viendo la página dinámica servida desde SQLite a través del
         pequeño CMS de wallermax-server: las páginas que ves abajo viven en
         la base de datos, se editan desde el panel y se renderizan como
         plantillas <code>.jhs</code> en el servidor.</p>
    </div>

<?jhs if (query.login_error || query.register_error) { ?>
    <p class="aviso aviso-error">No se pudo completar la operación: prueba a
       abrir el diálogo de <a href="#login">Entrar</a> o
       <a href="#registrar">Registro</a> de nuevo.</p>
<?jhs } ?>

    <section class="tarjeta" aria-labelledby="paginas-titulo">
      <h2 id="paginas-titulo">Páginas publicadas</h2>
<?jhs if (pages && pages.length) { ?>
      <ul class="lista">
<?jhs pages.forEach(function (pagina) { ?>
        <li>
          <div class="principal">
            <a href="/p/<?= pagina.slug ?>"><?= pagina.title ?></a>
            <div class="secundario">/p/<?= pagina.slug ?></div>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs } else { ?>
      <p class="vacio">Aún no hay páginas publicadas.</p>
<?jhs } ?>
    </section>

<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
    <section class="tarjeta aviso-info" aria-labelledby="cms-titulo">
      <h2 id="cms-titulo">Panel del CMS</h2>
      <p>Tienes rol de <strong><?= user.role ?></strong>: puedes
         <a href="/admin">gestionar las páginas</a> del sitio.</p>
    </section>
<?jhs } ?>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
