<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Home — wallermax</title>
  <link rel="stylesheet" href="/assets/wallermax.css">
</head>
<body>
<?jhs include("partials/header") ?>
<main>
  <div class="wrap">
    <div class="hero">
      <h1>A site that manages its own content</h1>
      <p>You are looking at the dynamic page served from SQLite through
         the small CMS inside wallermax-server: the pages listed below
         live in the database, are edited from the panel and render as
         <code>.jhs</code> templates on the server.</p>
    </div>

<?jhs if (query.login_error || query.register_error) { ?>
    <p class="aviso aviso-error">The operation could not be completed: try
       opening the <a href="#login">Sign in</a> or
       <a href="#register">Register</a> dialog again.</p>
<?jhs } ?>

    <section class="tarjeta" aria-labelledby="pages-title">
      <h2 id="pages-title">Published pages</h2>
<?jhs if (pages && pages.length) { ?>
      <ul class="lista">
<?jhs pages.forEach(function (page) { ?>
        <li>
          <div class="principal">
            <a href="/p/<?= page.slug ?>"><?= page.title ?></a>
            <div class="secundario">/p/<?= page.slug ?></div>
          </div>
        </li>
<?jhs }); ?>
      </ul>
<?jhs } else { ?>
      <p class="vacio">No published pages yet.</p>
<?jhs } ?>
    </section>

<?jhs if (user && (user.role == "admin" || user.role == "editor")) { ?>
    <section class="tarjeta aviso-info" aria-labelledby="cms-title">
      <h2 id="cms-title">CMS panel</h2>
      <p>You hold the <strong><?= user.role ?></strong> role: you can
         <a href="/admin">manage the site's pages</a>.</p>
    </section>
<?jhs } ?>
  </div>
</main>
<?jhs include("partials/footer") ?>
</body>
</html>
