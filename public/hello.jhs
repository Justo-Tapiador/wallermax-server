<?jhs
const title ="Plantilla .jhs";
const greeting ="Hola desde una plantilla .jhs";
const favicon ="/assets/favicon.png";
?>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <link rel="icon" type="image/png" href="<?= favicon ?>" />
  <title><?jhs echo(title) ?></title>
</head>
<body>
  <h1><?jhs echo(greeting) ?></h1>
<ul>
<?jhs
  var items = ["uno", "dos", "tres"];
  items.forEach(function (item, i) {?> <li><?jhs 
    echo("elemento " + (i + 1) + ": " + item);
    ?></li><?jhs 
  });
?> 
</ul>
  <p>Resultado de una expresión: <?= 40 + 2 ?></p>
  <p>Con escape automático: <?= "<b>no en negrita</b>" ?></p>
  <p>Sin escape (contenido de confianza): <?= raw("<b>sí en negrita</b>") ?></p>
  <p>Año actual: <?= new Date().getFullYear() ?></p>
<script>
   console.log("<?= 'línea de depuración desde la plantilla'?>");
</script>
  <p>El global <code>user</code> (null para visitantes anónimos):</p>
<pre>
<?jhs echo(JSON.stringify(user, null, 4)) ?>
</pre>

</body>
</html>
