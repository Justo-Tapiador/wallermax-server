<?jhs
const title =".jhs template";
const greeting ="Hello from a .jhs template";
const favicon ="/assets/favicon.png";
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <link rel="icon" type="image/png" href="<?= favicon ?>" />
  <title><?jhs echo(title) ?></title>
</head>
<body>
  <h1><?jhs echo(greeting) ?></h1>
<ul>
<?jhs
  var items = ["one", "two", "three"];
  items.forEach(function (item, i) {?>
 <li><?jhs
    echo("element " + (i + 1) + ": " + item);
    ?></li><?jhs
  });
?>
</ul>
  <p>The result of an expression: <?= 40 + 2 ?></p>
  <p>With auto-escaping: <?= "<b>not bold</b>" ?></p>
  <p>Without escaping (trusted content): <?= raw("<b>actually bold</b>") ?></p>
  <p>Current year: <?= new Date().getFullYear() ?></p>
<script>
   console.log("<?= 'debug line from the template'?>");
</script>
  <p>The <code>user</code> global (null for anonymous visitors):</p>
<pre>
<?jhs echo(JSON.stringify(user, null, 4)) ?>
</pre>

</body>
</html>
