# Rust build output
/target

# Local configuration overrides (see README.md)
wallermax.local.toml

# Timestamped backups wallermax-manager writes next to the config
# layers before overwriting them (wallermax.toml.bak-<timestamp>). A
# backup of the local layer can carry the same secrets as the file
# itself (e.g. [auth] jwt_secret), so it must stay out of the repo too.
wallermax.toml.bak-*
wallermax.local.toml.bak-*

# Environment files
.env

# Logs
*.log

# SQLite databases produced by local runs (see [database] in wallermax.toml)
*.db
*.db-wal
*.db-shm

# TLS material for [tls] development runs (never commit keys)
/certs

target/

# Media library uploads produced by local runs and test batteries
# (F9/F10: [cms] media_dir, default "media/" next to the binary)
/media
